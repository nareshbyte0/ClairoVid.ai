# Copy to .env.local. Never commit real credentials or use NEXT_PUBLIC_ for secrets.
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=clairovid

# Transactional email for verification and account recovery
RESEND_API_KEY=
EMAIL_FROM=ClairoVid.ai <accounts@example.com>

# AI provider keys are server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_INDIAN_MALE=
ELEVENLABS_VOICE_ID_INDIAN_FEMALE=

# Private Cloudflare R2 media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clairovid-dev

# Durable jobs (the generation/render worker still needs implementation and deployment)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Meta Instagram publishing; disabled until configured and app review is complete
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
